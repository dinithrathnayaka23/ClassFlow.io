# ==========================================================================
# ClassFlow - environment template. Copy to backend/.env and fill in.
# ==========================================================================
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit real credentials.
# Placeholders below are intentionally not valid values.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/classflow?sslmode=disable
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
# Generate one, e.g.:  openssl rand -base64 48
# Must be at least 32 characters. The application refuses to start without it.
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

# --- Server ---
SERVER_PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
UPLOAD_DIR=./uploads

# --- Admin account ---
# Admins cannot self-register; this is the only way an admin is created.
# Set a strong password before the first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
# Set to true for exactly one restart to rotate an existing admin password.
ADMIN_RESET_PASSWORD=false

# --- AI help ---
# Providers are tried in order; the first that answers wins. Leave a key blank
# to skip that provider. With both blank the assistant uses built-in guidance.
AI_PROVIDER_ORDER=gemini,groq
AI_TIMEOUT_SECONDS=20
# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Groq Console -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Object storage (deployment) -------------------------------------------
# Leave blank locally and uploads go to UPLOAD_DIR on disk. Set these when
# deploying: hosted containers have ephemeral filesystems, so anything a
# student submits is lost on the next redeploy unless it lives in a bucket.
# Works with any S3-compatible service (Cloudflare R2, Supabase, MinIO, AWS).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
