# ==========================================================================
# ClassFlow - environment template. Copy to backend/.env and fill in.
# ==========================================================================
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit real credentials.
# Placeholders below are intentionally not valid values.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/classflow?sslmode=disable
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
# Generate one, e.g.:  openssl rand -base64 48
# Must be at least 32 characters. The application refuses to start without it.
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

# --- Server ---
SERVER_PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
UPLOAD_DIR=./uploads

# --- Admin account ---
# Admins cannot self-register; this is the only way an admin is created.
# Set a strong password before the first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
# Set to true for exactly one restart to rotate an existing admin password.
ADMIN_RESET_PASSWORD=false
